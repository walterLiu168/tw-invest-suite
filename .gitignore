*$py.class
*.so
.Python
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# PowerShell
*.ps1.xml

# Outputs (1,962 generated HTML + caches — too big for git)
outputs/
*.log
*.tmp

# Public site (1,962 ticker HTML — generated, not source)
# Keep the entry points (analyze.html, watchlist.html, etc.) but exclude the analyze/ folder
public/analyze/[0-9]*.html
public/analyze/[0-9]*[A-Z].html

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Secrets
.env
*.pem
*.key
credentials.json

# Cache (the actual cache lives in ~/.cache_manager/, but just in case)
.cache/
*.cache

# Data (large files)
data/*.csv
data/*.parquet
data/*.db

# OS
$RECYCLE.BIN/

# Project-specific
_debug/

# D-code debug artifacts (D032-D044) — screenshots, debug HTML/bin, test logs
# Tracked utility scripts (e.g. _audit.py, _daily_backfill.py) start with _
# too, so we ignore by extension not by prefix.
src/_*.png
src/_*.html
src/_*.bin
src/_*.err
src/_*.js
src/__*.py
src/__*.png
src/__*.html
src/__*.bin
src/__*.err
src/_test_*.png
src/_test_*.html
src/_test_*.bin
src/_test_*.err
src/_test_*.log
src/_test_*.js
src/_test_artifacts/

# Underscore-prefixed debug/test scripts in src/ are throwaway per-D-code
# helpers. Tracked utilities (36 files) are explicitly whitelisted below.
src/_*.py
src/__*.py
